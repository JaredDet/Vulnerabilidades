@startuml
skinparam backgroundColor #E3F2FD
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontColor #344054
skinparam ArrowColor #37474F
skinparam activity {
  BackgroundColor #C3D2E9
  BorderColor #496BA5
  FontColor #344054
  DiamondBackgroundColor #C3D2E9
  DiamondBorderColor #496BA5
  StartColor #496BA5
  EndColor #496BA5
}
skinparam activityShape rectangle
skinparam partition {
  BackgroundColor transparent
  BorderColor #FF00AA
  FontColor #344054
}
title API de GitHub — Descubrimiento y clonación

left to right direction
skinparam linetype ortho
skinparam state {
  BackgroundColor #C3D2E9
  BorderColor #496BA5
  FontColor #344054
  RoundCorner 0
  RoundCorner<<terminal>> 40
  BackgroundColor<<fase>> transparent
  BorderColor<<fase>> #FF00AA
}
hide stereotype

state "Inicio" as inicio <<terminal>>
state "Validar organización, token,\npage-size y timeout" as parametros
state "Crear ejecución clone-<id>\ne inicializar page = 1" as ejecucion

state "Descubrimiento por página" as descubrimiento <<fase>> {
  state "Consultar repositorios públicos\nGET /orgs/{org}/repos\nper_page = page-size, page" as consultar
  state "Ordenar repositorios\nde la página por nombre" as ordenarPagina
  state "¿Página completa?" as paginaCompleta <<choice>>
  state "page = page + 1" as siguientePagina
}

state "Procesamiento por repositorio" as procesamiento <<fase>> {
  state "¿Quedan repositorios\nen la página?" as quedanRepos <<choice>>
  state "Tomar siguiente\nrepositorio" as siguienteRepo
  state "Clonar con Git\n--depth 1" as clonar
  state "¿Clonación correcta?" as clonCorrecto <<choice>>
  state "Registrar repositorio\ny ruta del clon" as registrarRuta
  state "Registrar repositorio\ny error de clonación" as registrarError
}

state "Consolidación de resultados" as consolidacion <<fase>> {
  state "Ordenar todos los resultados\npor nombre de repositorio" as ordenarResultados
  state "Guardar clones.json\nen clone-<id>" as guardar
}
state "Fin" as fin <<terminal>>

inicio --> parametros
parametros --> ejecucion
ejecucion --> consultar
consultar --> ordenarPagina
ordenarPagina --> quedanRepos
quedanRepos --> siguienteRepo : Sí
siguienteRepo --> clonar
clonar --> clonCorrecto
clonCorrecto --> registrarRuta : Sí
clonCorrecto --> registrarError : No
registrarRuta --> quedanRepos
registrarError --> quedanRepos
quedanRepos --> paginaCompleta : No
paginaCompleta --> siguientePagina : Sí
siguientePagina --> consultar
paginaCompleta --> ordenarResultados : No
ordenarResultados --> guardar
guardar --> fin

legend bottom
  page-size define el tamaño de cada página, no el total de repositorios.
  No se filtra por lenguaje. Los fallos de clonación permiten continuar.
  Un error de parámetros o de la API termina el comando.
endlegend
@enduml
